# Milvus in the VMware virtual machine
MILVUS_URI=http://192.168.88.161:19530
MILVUS_COLLECTION=research_knowledge
ATTU_URL=http://192.168.88.161:7000

# Recommended low-cost starting point: Alibaba Cloud Model Studio (Beijing).
# If the console gives you a workspace-specific API Host, use that instead.
# Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen3.5-flash
VISION_MODEL=qwen3.5-flash
EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Local fallback for the first text smoke test
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:1.7b

# SEC EDGAR automated access identity.
# Replace the example email in the real .env file.
SEC_USER_AGENT=ResearchKB your-email@example.com
